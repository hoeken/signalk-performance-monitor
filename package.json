{
  "name": "signalk-performance-monitor",
  "version": "1.0.0",
  "description": "Always-on event-loop metrics and on-demand CPU/allocation profiling for Signal K server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "public",
    "docs/screenshots",
    "webapp/public/icon.png"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:webapp",
    "build:plugin": "tsc -p tsconfig.json",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p webapp/tsconfig.json",
    "test": "npm run test:backend && npm run test:webapp",
    "test:backend": "vitest run --config vitest.config.ts",
    "test:webapp": "vitest run --config webapp/vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "performance",
    "profiler",
    "cpu",
    "monitoring",
    "diagnostics"
  ],
  "author": "Zach Hoeken <hoeken@gmail.com>",
  "license": "MIT",
  "signalk": {
    "displayName": "Performance Monitor",
    "appIcon": "icon.png",
    "screenshots": [
      "./docs/screenshots/home.png",
      "./docs/screenshots/cpu.png",
      "./docs/screenshots/memory.png"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/signalk-performance-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/hoeken/signalk-performance-monitor/issues"
  },
  "homepage": "https://github.com/hoeken/signalk-performance-monitor#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@signalk/server-api": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "daisyui": "^5.7.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^4.19.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  }
}
